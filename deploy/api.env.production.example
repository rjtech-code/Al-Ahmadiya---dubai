# Production settings for the API. On the server copy to apps/api/.env and fill in every value.
# Never commit the filled-in file. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# Managed PostgreSQL connection string (keep sslmode=require for a remote database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

JWT_ACCESS_SECRET=
COOKIE_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14

# Public site address (https). CORS_ORIGINS may list several, comma-separated.
WEB_BASE_URL=https://example.com
CORS_ORIGINS=https://example.com
# The API reaches the website directly on the same server for cache refreshes
WEB_INTERNAL_URL=http://127.0.0.1:3000
# Same value as REVALIDATE_SECRET in apps/web/.env.production.local
REVALIDATE_SECRET=

# Uploaded videos, notes and documents. Use an absolute path that is backed up.
STORAGE_DIR=/var/lib/ahmadiya/storage
MAX_VIDEO_MB=2048

SHOW_DEMO_CONTENT=false

# Used once by `npm run db:seed` to create the first Super Admin (14+ chars, upper, lower, digit).
# Remove the password from this file after the first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payments: razorpay (live keys from the Razorpay dashboard) or none
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Webhooks → URL https://example.com/api/v1/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Live classes (self-hosted media server). Open UDP+TCP 40000-40200 in the firewall.
LIVE_LISTEN_IP=0.0.0.0
LIVE_ANNOUNCED_IP=SERVER_PUBLIC_IP
LIVE_RTC_MIN_PORT=40000
LIVE_RTC_MAX_PORT=40200
