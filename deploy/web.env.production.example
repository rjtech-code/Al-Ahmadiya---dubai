# Production settings for the website. On the server copy to apps/web/.env.production.local.
# NEXT_PUBLIC_* values are fixed at build time: rebuild after changing them.
API_ORIGIN=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=https://example.com
# Leave empty: the live-class websocket then uses the site's own address (Nginx forwards /socket.io/)
NEXT_PUBLIC_API_ORIGIN=
# Same value as REVALIDATE_SECRET in apps/api/.env
REVALIDATE_SECRET=
