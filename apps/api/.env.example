NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pragati@localhost/al_ahmadiya?host=/var/run/postgresql
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
COOKIE_SECRET=replace-with-64-hex-chars
CORS_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
STORAGE_DIR=./storage
SHOW_DEMO_CONTENT=false
SEED_ADMIN_EMAIL=admin@localhost.test
SEED_ADMIN_PASSWORD=set-a-strong-password
# Payments: razorpay | test (development only) | none
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
MAX_VIDEO_MB=2048
REVALIDATE_SECRET=replace-with-shared-secret
# Live classes run on our own media server (mediasoup). Open these UDP/TCP ports on the server;
# set LIVE_ANNOUNCED_IP to the server's public IP in production.
LIVE_LISTEN_IP=0.0.0.0
LIVE_ANNOUNCED_IP=127.0.0.1
LIVE_RTC_MIN_PORT=40000
LIVE_RTC_MAX_PORT=40200
