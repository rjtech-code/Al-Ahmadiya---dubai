# Origin of the NestJS API (server-side fetches and /api/v1 rewrites)
API_ORIGIN=http://localhost:4000
# Public canonical origin of the website (SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared with the API: lets admin changes refresh cached public pages immediately
REVALIDATE_SECRET=replace-with-shared-secret
# Browser-reachable API origin for live-class signalling when it is hosted separately.
# For Vercel + Render, set this to the Render API origin. For same-origin reverse proxy, leave blank.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Optional dedicated live-signalling origin; overrides NEXT_PUBLIC_API_ORIGIN when set.
NEXT_PUBLIC_LIVE_ORIGIN=
